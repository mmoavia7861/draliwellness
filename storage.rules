rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public website images are readable; only the verified primary admin
    // may upload new product imagery. No arbitrary file types or large uploads.
    match /product-images/{ownerUid}/{filename} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'moavia400@gmail.com'
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null
        && request.auth.uid == ownerUid
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'moavia400@gmail.com';
    }

    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
