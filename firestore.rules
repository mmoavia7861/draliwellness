rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'moavia400@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerifiedUser() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super_admin', 'editor']);
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() ||
        (isVerifiedUser() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 128 && slug.matches('^[a-z0-9\\-]+$');
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'slug', 'name', 'brand', 'pricePkr', 'stock', 'published', 'complianceStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'slug', 'name', 'subtitle', 'brand', 'founderMention', 'categoryIds',
          'shortDescription', 'overview', 'format', 'packSize', 'strength', 'usageSummary',
          'pricePkr', 'compareAtPricePkr', 'stock', 'sku', 'imageUrl', 'galleryUrls',
          'benefits', 'ingredientsSummary', 'supplementFacts', 'otherIngredients',
          'directions', 'warnings', 'storageInstructions', 'allergens', 'interactions',
          'manufacturer', 'countryOfOrigin', 'batchNo', 'mfgDate', 'expDate',
          'enlistmentNo', 'form7No', 'certifications', 'faqs', 'variants',
          'featured', 'published', 'complianceStatus', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidSlug(data.slug)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 160
        && data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 80
        && data.pricePkr is number && data.pricePkr >= 0 && data.pricePkr <= 1000000
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && data.published is bool
        && data.complianceStatus in ['draft', 'awaiting_docs', 'under_review', 'approved', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isOptionalString(data, 'subtitle', 240)
        && isOptionalString(data, 'founderMention', 80)
        && isOptionalString(data, 'shortDescription', 500)
        && isOptionalString(data, 'overview', 4000)
        && isOptionalString(data, 'format', 80)
        && isOptionalString(data, 'packSize', 80)
        && isOptionalString(data, 'strength', 80)
        && isOptionalString(data, 'usageSummary', 160)
        && isOptionalNumber(data, 'compareAtPricePkr', 0, 1000000)
        && isOptionalString(data, 'sku', 64)
        && isOptionalString(data, 'imageUrl', 600)
        && isOptionalString(data, 'ingredientsSummary', 2000)
        && isOptionalString(data, 'otherIngredients', 1000)
        && isOptionalString(data, 'directions', 2000)
        && isOptionalString(data, 'warnings', 2000)
        && isOptionalString(data, 'storageInstructions', 1000)
        && isOptionalString(data, 'allergens', 500)
        && isOptionalString(data, 'interactions', 1000)
        && isOptionalString(data, 'manufacturer', 300)
        && isOptionalString(data, 'countryOfOrigin', 80)
        && isOptionalString(data, 'batchNo', 64)
        && isOptionalString(data, 'mfgDate', 32)
        && isOptionalString(data, 'expDate', 32)
        && isOptionalString(data, 'enlistmentNo', 64)
        && isOptionalString(data, 'form7No', 64)
        && isOptionalBool(data, 'featured')
        && isOptionalNumber(data, 'sortOrder', -1000, 100000)
        && (!('categoryIds' in data) || (data.categoryIds is list && data.categoryIds.size() <= 10))
        && (!('galleryUrls' in data) || (data.galleryUrls is list && data.galleryUrls.size() <= 8))
        && (!('benefits' in data) || (data.benefits is list && data.benefits.size() <= 12))
        && (!('supplementFacts' in data) || (data.supplementFacts is list && data.supplementFacts.size() <= 20))
        && (!('certifications' in data) || (data.certifications is list && data.certifications.size() <= 8))
        && (!('faqs' in data) || (data.faqs is list && data.faqs.size() <= 10))
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 12));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'slug', 'name', 'active', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'name', 'description', 'imageUrl', 'active', 'sortOrder', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidSlug(data.slug)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && isOptionalString(data, 'description', 400)
        && isOptionalString(data, 'imageUrl', 600)
        && data.active is bool
        && data.sortOrder is number && data.sortOrder >= -1000 && data.sortOrder <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['id', 'businessName', 'shippingFeePkr', 'freeShippingThresholdPkr', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'businessName', 'supplementBrandName', 'tagline',
          'announcementEnabled', 'announcementText', 'heroHeadline', 'heroSubheadline',
          'banners', 'bannerIntervalSec',
          'founderName', 'founderTitle', 'founderPhotoUrl', 'founderBio', 'founderMission',
          'whatsappNumber', 'whatsappGreeting', 'supportEmail', 'supportHours',
          'shippingFeePkr', 'freeShippingThresholdPkr', 'codEnabled', 'onlinePaymentsEnabled',
          'faqs', 'policies', 'socialLinks', 'seoTitle', 'seoDescription', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.shippingFeePkr is number && data.shippingFeePkr >= 0 && data.shippingFeePkr <= 50000
        && data.freeShippingThresholdPkr is number && data.freeShippingThresholdPkr >= 0 && data.freeShippingThresholdPkr <= 500000
        && data.updatedAt is timestamp
        && isOptionalString(data, 'supplementBrandName', 80)
        && isOptionalString(data, 'tagline', 200)
        && isOptionalBool(data, 'announcementEnabled')
        && isOptionalString(data, 'announcementText', 240)
        && isOptionalString(data, 'heroHeadline', 200)
        && isOptionalString(data, 'heroSubheadline', 400)
        && (!('banners' in data) || (data.banners is list && data.banners.size() <= 12))
        && isOptionalNumber(data, 'bannerIntervalSec', 2, 60)
        && isOptionalString(data, 'founderName', 120)
        && isOptionalString(data, 'founderTitle', 120)
        && isOptionalString(data, 'founderPhotoUrl', 600)
        && isOptionalString(data, 'founderBio', 3000)
        && isOptionalString(data, 'founderMission', 1000)
        && isOptionalString(data, 'whatsappNumber', 32)
        && isOptionalString(data, 'whatsappGreeting', 300)
        && isOptionalString(data, 'supportEmail', 120)
        && isOptionalString(data, 'supportHours', 160)
        && isOptionalBool(data, 'codEnabled')
        && isOptionalBool(data, 'onlinePaymentsEnabled')
        && isOptionalString(data, 'seoTitle', 160)
        && isOptionalString(data, 'seoDescription', 320)
        && (!('faqs' in data) || (data.faqs is list && data.faqs.size() <= 20))
        && (!('policies' in data) || data.policies is map)
        && (!('socialLinks' in data) || data.socialLinks is map);
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'trackingKey', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'city', 'items', 'subtotalPkr',
          'shippingFeePkr', 'totalPkr', 'paymentMethod', 'paymentStatus', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'trackingKey', 'customerName', 'customerEmail',
          'customerPhone', 'shippingAddress', 'city', 'province', 'postalCode', 'notes',
          'items', 'subtotalPkr', 'discountPkr', 'couponCode', 'shippingFeePkr', 'totalPkr',
          'paymentMethod', 'paymentStatus', 'status', 'courierName', 'courierTrackingNo',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && isValidId(data.trackingKey)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160
        && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 32
        && data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 400
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && isOptionalString(data, 'province', 80)
        && isOptionalString(data, 'postalCode', 20)
        && isOptionalString(data, 'notes', 500)
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.subtotalPkr is number && data.subtotalPkr >= 0 && data.subtotalPkr <= 10000000
        && isOptionalNumber(data, 'discountPkr', 0, 10000000)
        && isOptionalString(data, 'couponCode', 40)
        && data.shippingFeePkr is number && data.shippingFeePkr >= 0 && data.shippingFeePkr <= 100000
        && data.totalPkr is number && data.totalPkr >= 0 && data.totalPkr <= 10000000
        && data.paymentMethod in ['cod', 'whatsapp', 'jazzcash', 'easypaisa', 'card']
        && data.paymentStatus in ['pending', 'paid', 'failed', 'refunded']
        && data.status in ['placed', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled']
        && isOptionalString(data, 'courierName', 80)
        && isOptionalString(data, 'courierTrackingNo', 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll(['orderNumber', 'status', 'paymentMethod', 'paymentStatus', 'totalPkr', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'orderNumber', 'status', 'paymentMethod', 'paymentStatus', 'city',
          'totalPkr', 'itemCount', 'itemsSummary', 'courierName', 'courierTrackingNo',
          'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 32
        && data.status in ['placed', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.paymentMethod is string && data.paymentMethod.size() <= 32
        && data.paymentStatus is string && data.paymentStatus.size() <= 32
        && isOptionalString(data, 'city', 80)
        && data.totalPkr is number && data.totalPkr >= 0 && data.totalPkr <= 10000000
        && isOptionalNumber(data, 'itemCount', 1, 100)
        && (!('itemsSummary' in data) || (data.itemsSummary is list && data.itemsSummary.size() <= 30))
        && isOptionalString(data, 'courierName', 80)
        && isOptionalString(data, 'courierTrackingNo', 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'discountType', 'value', 'active', 'createdAt'])
        && data.keys().hasOnly(['code', 'discountType', 'value', 'minOrderPkr', 'active', 'expiresAt', 'createdAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40 && data.code.matches('^[A-Z0-9_\\-]+$')
        && data.discountType in ['percent', 'fixed']
        && data.value is number && data.value >= 0 && data.value <= 100000
        && isOptionalNumber(data, 'minOrderPkr', 0, 1000000)
        && data.active is bool
        && isOptionalString(data, 'expiresAt', 40)
        && data.createdAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll(['id', 'title', 'visible', 'bookingEnabled', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'title', 'description', 'providerName', 'providerQualifications',
          'durationMinutes', 'feePkr', 'visible', 'bookingEnabled', 'sortOrder',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && isOptionalString(data, 'description', 1000)
        && isOptionalString(data, 'providerName', 120)
        && isOptionalString(data, 'providerQualifications', 200)
        && isOptionalNumber(data, 'durationMinutes', 5, 300)
        && isOptionalNumber(data, 'feePkr', 0, 500000)
        && data.visible is bool
        && data.bookingEnabled is bool
        && data.sortOrder is number && data.sortOrder >= -1000 && data.sortOrder <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['id', 'userId', 'serviceId', 'customerName', 'customerPhone', 'preferredDate', 'preferredSlot', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'serviceId', 'serviceTitle', 'customerName', 'customerEmail',
          'customerPhone', 'preferredDate', 'preferredSlot', 'notes', 'status',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && isValidId(data.serviceId)
        && isOptionalString(data, 'serviceTitle', 120)
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 120
        && isOptionalString(data, 'customerEmail', 160)
        && data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 32
        && data.preferredDate is string && data.preferredDate.size() >= 4 && data.preferredDate.size() <= 32
        && data.preferredSlot is string && data.preferredSlot.size() >= 2 && data.preferredSlot.size() <= 40
        && isOptionalString(data, 'notes', 400)
        && data.status in ['requested', 'confirmed', 'rescheduled', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'authorName', 'rating', 'comment', 'approved', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'userId', 'authorName', 'rating', 'comment', 'approved', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1000
        && data.approved is bool
        && data.createdAt is timestamp;
    }

    function isValidJournalPost(data) {
      return data.keys().hasAll(['id', 'slug', 'title', 'category', 'published', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'title', 'category', 'summary', 'content', 'authorName', 'published', 'publishedAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidSlug(data.slug)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 200
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && isOptionalString(data, 'summary', 500)
        && isOptionalString(data, 'content', 12000)
        && isOptionalString(data, 'authorName', 120)
        && data.published is bool
        && isOptionalString(data, 'publishedAt', 40)
        && data.updatedAt is timestamp;
    }

    function isValidContactInquiry(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isOptionalString(data, 'phone', 32)
        && isOptionalString(data, 'subject', 160)
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && data.status in ['new', 'replied', 'closed']
        && data.createdAt is timestamp;
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll(['id', 'email', 'consent', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'consent', 'createdAt'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 4 && data.email.size() <= 160
        && data.consent == true
        && data.createdAt is timestamp;
    }

    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateProfile(data) {
      return data.keys().hasAll(['email', 'updatedAt'])
        && data.keys().hasOnly(['email', 'phone', 'addresses', 'wishlistProductIds', 'newsletterOptIn', 'updatedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isOptionalString(data, 'phone', 32)
        && (!('addresses' in data) || (data.addresses is list && data.addresses.size() <= 10))
        && (!('wishlistProductIds' in data) || (data.wishlistProductIds is list && data.wishlistProductIds.size() <= 50))
        && isOptionalBool(data, 'newsletterOptIn')
        && data.updatedAt is timestamp;
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role in ['super_admin', 'editor']
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'action', 'targetCollection', 'targetId', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'])
        && isValidId(data.id)
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && isOptionalString(data, 'actorEmail', 160)
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 120
        && data.targetCollection is string && data.targetCollection.size() >= 2 && data.targetCollection.size() <= 64
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && isOptionalString(data, 'summary', 400)
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow get: if isValidId(productId) && ((existing().published == true && existing().complianceStatus == 'approved') || isAdmin());
      allow list: if (existing().published == true && existing().complianceStatus == 'approved') || isAdmin();
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().active == true || isAdmin());
      allow list: if existing().active == true || isAdmin();
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isValidId(settingId) && isAdmin() && isValidSiteSettings(incoming())
        && incoming().id == settingId
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin() && isValidSiteSettings(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().status == 'placed'
        && incoming().paymentStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isVerifiedUser() && incoming().userId == request.auth.uid) ||
          (!isSignedIn() && incoming().userId == 'guest')
        )
        && existsAfter(/databases/$(database)/documents/orderTracking/$(incoming().trackingKey));
      allow update: if isValidId(orderId) && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().orderNumber == existing().orderNumber
        && incoming().userId == existing().userId
        && incoming().trackingKey == existing().trackingKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isVerifiedUser()
            && existing().userId == request.auth.uid
            && existing().status == 'placed'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /orderTracking/{trackingKey} {
      allow get: if isValidId(trackingKey);
      allow list: if false;
      allow create: if isValidId(trackingKey) && isValidOrderTracking(incoming())
        && incoming().status == 'placed'
        && incoming().paymentStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(trackingKey) && isValidOrderTracking(incoming())
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if false;
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if isAdmin();
      allow create: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming())
        && incoming().code == couponId
        && incoming().createdAt == request.time;
      allow update: if isValidId(couponId) && isAdmin() && isValidCoupon(incoming())
        && incoming().code == existing().code
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(couponId) && isAdmin();
    }

    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && (existing().visible == true || isAdmin());
      allow list: if existing().visible == true || isAdmin();
      allow create: if isValidId(serviceId) && isAdmin() && isValidService(incoming())
        && incoming().id == serviceId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(serviceId) && isAdmin() && isValidService(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(serviceId) && isAdmin();
    }

    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(appointmentId) && isVerifiedUser() && isValidAppointment(incoming())
        && incoming().id == appointmentId
        && incoming().userId == request.auth.uid
        && incoming().status == 'requested'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/services/$(incoming().serviceId))
        && get(/databases/$(database)/documents/services/$(incoming().serviceId)).data.bookingEnabled == true;
      allow update: if isValidId(appointmentId) && isValidAppointment(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().serviceId == existing().serviceId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isVerifiedUser()
            && existing().userId == request.auth.uid
            && existing().status in ['requested', 'confirmed']
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().approved == true || isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if existing().approved == true || isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(reviewId) && isVerifiedUser() && isValidReview(incoming())
        && incoming().id == reviewId
        && incoming().userId == request.auth.uid
        && incoming().approved == false
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isValidId(reviewId) && isAdmin() && isValidReview(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(reviewId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    match /journalPosts/{postId} {
      allow get: if isValidId(postId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();
      allow create, update: if isValidId(postId) && isAdmin() && isValidJournalPost(incoming())
        && incoming().id == postId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(postId) && isAdmin();
    }

    match /contactInquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidContactInquiry(incoming())
        && incoming().id == inquiryId
        && incoming().status == 'new'
        && incoming().createdAt == request.time;
      allow update: if isValidId(inquiryId) && isAdmin() && isValidContactInquiry(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    match /newsletterSubscribers/{subscriberId} {
      allow get, list, delete: if isAdmin();
      allow create: if isValidId(subscriberId) && isValidNewsletterSubscriber(incoming())
        && incoming().id == subscriberId
        && incoming().createdAt == request.time;
      allow update: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) && isValidUserPublic(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin()) && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'profile' && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create, update: if isValidId(userId) && docId == 'profile' && isVerifiedUser() && (isOwner(userId) || isAdmin())
          && isValidUserPrivateProfile(incoming())
          && incoming().updatedAt == request.time;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSuperAdmin();
      // Only a super admin can grant access. Initial self-bootstrap is allowed
      // exclusively for the designated verified owner email.
      allow create: if isValidId(userId)
        && isValidAdminMember(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && (
          (isBootstrappedAdmin() && userId == request.auth.uid
            && incoming().role == 'super_admin'
            && incoming().email == request.auth.token.email)
          || (isSuperAdmin() && userId != request.auth.uid)
        );
      allow update: if isValidId(userId) && isSuperAdmin()
        && userId != request.auth.uid
        && isValidAdminMember(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isSuperAdmin()
        && userId != request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /test/{docId} {
      allow get: if docId == 'connection';
    }
  }
}
